{
  "name": "hospital-management-system",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "description": "A comprehensive hospital management system with web, mobile, and desktop applications",
  "author": {
    "name": "XiHoyu",
    "url": "https://github.com/XiHoyu"
  },
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "pnpm -rF @hospital/backend run dev",
    "dev:web": "pnpm -rF @hospital/web run dev",
    "dev:mobile": "pnpm -rF @hospital/mobile run dev",
    "dev:desktop": "pnpm -rF @hospital/desktop run dev",
    "build": "turbo run build",
    "build:web": "pnpm -rF @hospital/web run build",
    "build:mobile": "pnpm -rF @hospital/mobile run build",
    "build:desktop": "pnpm -rF @hospital/desktop run build",
    "build:backend": "pnpm -rF @hospital/backend run build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "pnpm -rF=\"./apps/*\" -F=\"./packages/*\" --parallel typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.0.0",
    "eslint": "^8.52.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "turbo": "^2.0.0",
    "prettier": "^3.1.0"
  },
  "keywords": [
    "hospital",
    "management",
    "healthcare",
    "patient",
    "medical",
    "appointment"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": "^9.0.0"
  }
}

{
  "name": "hospital-backend",
  "version": "1.0.0",
  "description": "Backend API server for Hospital Management System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:up": "node scripts/migrate-up.js",
    "migrate:down": "node scripts/migrate-down.js",
    "seed": "node scripts/seed.js",
    "db:backup": "node scripts/backup.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "echo 'Backend build complete'",
    "format": "prettier --write ."
  },
  "keywords": [
    "hospital",
    "management",
    "api",
    "healthcare"
  ],
  "author": "XiHoyu",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "pg": "^8.11.2",
    "redis": "^4.6.11",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "twilio": "^3.98.1",
    "stripe": "^13.11.0",
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "uuid": "^9.0.1",
    "socket.io": "^4.7.2",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "eslint": "^8.52.0",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}

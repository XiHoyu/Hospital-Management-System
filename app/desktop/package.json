{
  "name": "hospital-desktop-app",
  "version": "1.0.0",
  "description": "Desktop application for Hospital Management System",
  "main": "main.js",
  "homepage": "./",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npm run electron\"",
    "build:electron": "npm run build && npm run electron-build",
    "electron-build": "electron-builder",
    "electron-build:win": "npm run build && electron-builder --win",
    "electron-build:mac": "npm run build && electron-builder --mac",
    "electron-build:linux": "npm run build && electron-builder --linux",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.17.0",
    "axios": "^1.6.2",
    "redux": "^4.2.1",
    "react-redux": "^8.1.3",
    "@reduxjs/toolkit": "^1.9.7",
    "@mui/material": "^5.14.7",
    "@mui/icons-material": "^5.14.7",
    "tailwindcss": "^3.3.5",
    "react-toastify": "^9.1.3",
    "react-hook-form": "^7.48.0",
    "recharts": "^2.10.3",
    "socket.io-client": "^4.7.2",
    "jwt-decode": "^4.0.0",
    "electron-squirrel-startup": "^1.1.0"
  },
  "devDependencies": {
    "react-scripts": "5.0.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.1.4",
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.1",
    "eslint": "^8.52.0",
    "prettier": "^3.0.3"
  },
  "build": {
    "appId": "com.hospital.management",
    "productName": "Hospital Management System",
    "files": [
      "build/**/*",
      "main.js",
      "preload.js"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
